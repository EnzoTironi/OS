FROM node:22.18.0-bookworm-slim

WORKDIR /app
COPY . .
RUN npm ci \
    && npm run build \
    && npx tsc -p archive/packages/effect-worker/tsconfig.json --pretty false \
    && node deploy/scripts/preload-embedding-model.mjs \
    && npm cache clean --force \
    && chown -R node:node /app

ENV NODE_ENV=production
USER node
CMD ["node", "archive/apps/web/.output/server/index.mjs"]
