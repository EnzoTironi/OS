#!/bin/sh
set -eu
mkdir -p /data/rivet
/usr/local/bin/rivet-engine start &
engine=$!
for _ in $(seq 1 120); do
  if curl -sf -o /dev/null "http://127.0.0.1:6420/health" 2>/dev/null \
    || curl -sf -o /dev/null "http://127.0.0.1:6420/" 2>/dev/null; then
    break
  fi
  sleep 1
done
curl -sf -X PUT \
  "http://127.0.0.1:6420/runner-configs/default?namespace=default" \
  -H "authorization: Bearer admin" \
  -H "content-type: application/json" \
  -d '{"datacenters":{"default":{"normal":{}}}}'
wait $engine
