#!/bin/sh
set -eu

if [ "${ZOEN_EFFECT_HANDLER_ENV_CLEAN:-}" != "1" ]; then
  exec env -i \
    PATH=/usr/local/bin:/usr/bin:/bin \
    NODE_ENV=production \
    ZOEN_EFFECT_HANDLER_ENV_CLEAN=1 \
    ZOEN_CONNECTOR_CALLER_TOKEN="${ZOEN_CONNECTOR_CALLER_TOKEN:?ZOEN_CONNECTOR_CALLER_TOKEN required}" \
    ZOEN_CONNECTOR_CREDENTIAL_REFS="${ZOEN_CONNECTOR_CREDENTIAL_REFS:?ZOEN_CONNECTOR_CREDENTIAL_REFS required}" \
    ZOEN_EFFECT_CONNECTOR_TIMEOUT_MS="${ZOEN_EFFECT_CONNECTOR_TIMEOUT_MS:-10000}" \
    ZOEN_EFFECT_CONNECTOR_URL="${ZOEN_EFFECT_CONNECTOR_URL:-http://127.0.0.1:8081/v1/effects}" \
    ZOEN_EFFECT_HANDLER_PORT="${ZOEN_EFFECT_HANDLER_PORT:-9081}" \
    ZOEN_EFFECT_REGISTRATION_LEASE_MAX_AGE_MS="${ZOEN_EFFECT_REGISTRATION_LEASE_MAX_AGE_MS:-5000}" \
    ZOEN_EFFECT_REGISTRATION_STATUS_URL="${ZOEN_EFFECT_REGISTRATION_STATUS_URL:-http://127.0.0.1:9082/status}" \
    ZOEN_EFFECT_SERVICE_TIMEOUT_MS="${ZOEN_EFFECT_SERVICE_TIMEOUT_MS:-5000}" \
    ZOEN_EFFECT_WORKER_ACTOR_ID="${ZOEN_EFFECT_WORKER_ACTOR_ID:?ZOEN_EFFECT_WORKER_ACTOR_ID required}" \
    ZOEN_EFFECT_WORKER_API_KEY_FILE="${ZOEN_EFFECT_WORKER_API_KEY_FILE:-/data/zoen/effect-worker.api-key}" \
    ZOEN_EFFECT_WORKER_CREDENTIAL_READY_FILE="${ZOEN_EFFECT_WORKER_CREDENTIAL_READY_FILE:-/run/zoen/effect-worker-credential.ready}" \
    ZOEN_EFFECT_WORKER_PRINCIPAL_ID="${ZOEN_EFFECT_WORKER_PRINCIPAL_ID:?ZOEN_EFFECT_WORKER_PRINCIPAL_ID required}" \
    ZOEN_EFFECT_WORKER_WORKLOAD_ID="${ZOEN_EFFECT_WORKER_WORKLOAD_ID:-workload.effect-worker}" \
    ZOEN_TENANT_ID="${ZOEN_TENANT_ID:?ZOEN_TENANT_ID required}" \
    ZOEN_ZOEND="${ZOEN_ZOEND:-http://127.0.0.1:58701}" \
    "$0" "$@"
fi

ready_file="${ZOEN_EFFECT_WORKER_CREDENTIAL_READY_FILE:-/run/zoen/effect-worker-credential.ready}"
while [ ! -s "$ready_file" ]; do
  sleep 1
done

exec /usr/local/bin/zoen-effect-handler
