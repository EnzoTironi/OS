#!/bin/sh
set -eu
wait_oidc() {
  url="$1/.well-known/openid-configuration"
  until python3 -c 'import sys, urllib.request; urllib.request.urlopen(sys.argv[1], timeout=2)' "$url" >/dev/null 2>&1; do
    sleep 1
  done
}
base="${ZOEN_OIDC_DISCOVERY_URL:-${ZOEN_OIDC_ISSUER:?ZOEN_OIDC_ISSUER required}}"
base="${base%/}"
wait_oidc "$base"
exec "$@"
