#!/bin/sh
set -eu

if [ "${ZOEN_EFFECT_CREDENTIAL_ENV_CLEAN:-}" != "1" ]; then
  exec env -i \
    PATH=/usr/local/bin:/usr/bin:/bin \
    ZOEN_EFFECT_CREDENTIAL_ENV_CLEAN=1 \
    ZOEN_EFFECT_CREDENTIAL_CHECK_INTERVAL_SECONDS="${ZOEN_EFFECT_CREDENTIAL_CHECK_INTERVAL_SECONDS:-5}" \
    ZOEN_EFFECT_WORKER_ACTOR_ID="${ZOEN_EFFECT_WORKER_ACTOR_ID:?ZOEN_EFFECT_WORKER_ACTOR_ID required}" \
    ZOEN_EFFECT_WORKER_API_KEY_FILE="${ZOEN_EFFECT_WORKER_API_KEY_FILE:-/data/zoen/effect-worker.api-key}" \
    ZOEN_EFFECT_WORKER_CREDENTIAL_READY_FILE="${ZOEN_EFFECT_WORKER_CREDENTIAL_READY_FILE:-/run/zoen/effect-worker-credential.ready}" \
    ZOEN_EFFECT_WORKER_PRINCIPAL_ID="${ZOEN_EFFECT_WORKER_PRINCIPAL_ID:?ZOEN_EFFECT_WORKER_PRINCIPAL_ID required}" \
    ZOEN_EFFECT_WORKER_WORKLOAD_ID="${ZOEN_EFFECT_WORKER_WORKLOAD_ID:-workload.effect-worker}" \
    ZOEN_TENANT_ID="${ZOEN_TENANT_ID:?ZOEN_TENANT_ID required}" \
    ZOEN_ZOEND="${ZOEN_ZOEND:-http://127.0.0.1:58701}" \
    "$0" "$@"
fi

key_file="${ZOEN_EFFECT_WORKER_API_KEY_FILE:-/data/zoen/effect-worker.api-key}"
ready_file="${ZOEN_EFFECT_WORKER_CREDENTIAL_READY_FILE:-/run/zoen/effect-worker-credential.ready}"
zoend="${ZOEN_ZOEND:-http://127.0.0.1:58701}"
tenant_id="${ZOEN_TENANT_ID:?ZOEN_TENANT_ID required}"
workload_id="${ZOEN_EFFECT_WORKER_WORKLOAD_ID:-workload.effect-worker}"
principal_id="${ZOEN_EFFECT_WORKER_PRINCIPAL_ID:?ZOEN_EFFECT_WORKER_PRINCIPAL_ID required}"
actor_id="${ZOEN_EFFECT_WORKER_ACTOR_ID:?ZOEN_EFFECT_WORKER_ACTOR_ID required}"
interval_seconds="${ZOEN_EFFECT_CREDENTIAL_CHECK_INTERVAL_SECONDS:-5}"
once=false
if [ "${1:-}" = "--once" ]; then
  once=true
elif [ "$#" -ne 0 ]; then
  echo "usage: zoen-ensure-effect-workload-credential [--once]" >&2
  exit 2
fi

umask 077
mkdir -p "$(dirname "$ready_file")"
trap 'exit 0' HUP INT TERM

file_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"
}

validate() {
  if [ ! -f "$key_file" ] || [ -L "$key_file" ]; then
    echo "effect credential: API key must be an existing regular non-symlink file" >&2
    return 1
  fi
  mode="$(file_mode "$key_file")"
  if [ "$mode" != "600" ]; then
    echo "effect credential: API key file mode must be 0600 (found ${mode})" >&2
    return 1
  fi
  if [ ! -s "$key_file" ]; then
    echo "effect credential: API key file is empty" >&2
    return 1
  fi

  temporary="$(mktemp -d "$(dirname "$ready_file")/.effect-credential.XXXXXX")"
  marker_file="${temporary}/ready.json"
  trap 'rm -rf "$temporary"' EXIT
  if ! python3 - "$key_file" "$marker_file" "$zoend" "$tenant_id" "$workload_id" "$principal_id" "$actor_id" <<'PY'
import json
import os
import stat
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

key_path, marker_path, zoend, tenant, workload, principal, actor = sys.argv[1:]
base = urllib.parse.urlsplit(zoend)
if (
    base.scheme != "http"
    or base.hostname not in {"127.0.0.1", "::1", "localhost"}
    or base.username is not None
    or base.password is not None
    or base.path not in {"", "/"}
    or base.query
    or base.fragment
):
    raise SystemExit("effect credential: ZOEN_ZOEND must be a loopback HTTP origin")
try:
    descriptor = os.open(key_path, os.O_RDONLY | os.O_NOFOLLOW)
    status = os.fstat(descriptor)
    if not stat.S_ISREG(status.st_mode):
        raise SystemExit("effect credential: API key must be a regular file")
    if stat.S_IMODE(status.st_mode) != 0o600:
        raise SystemExit("effect credential: API key file mode must be 0600")
    with os.fdopen(descriptor, encoding="utf-8") as source:
        document = source.read()
except OSError as error:
    raise SystemExit(f"effect credential: API key file cannot be read: {error}")
api_key = document[:-1] if document.endswith("\n") else document
if not api_key or api_key != api_key.strip():
    raise SystemExit("effect credential: API key file is malformed")
request = urllib.request.Request(
    urllib.parse.urljoin(zoend.rstrip("/") + "/", "workload/authenticate"),
    data=json.dumps({"apiKey": api_key}, separators=(",", ":")).encode(),
    headers={"content-type": "application/json"},
    method="POST",
)
try:
    with urllib.request.urlopen(request, timeout=5) as response:
        status_code = response.status
        response_bytes = response.read(1_048_577)
except urllib.error.HTTPError as error:
    error.close()
    raise SystemExit(
        f"effect credential: authentication failed with HTTP {error.code}"
    ) from error
except (OSError, TimeoutError, urllib.error.URLError) as error:
    raise SystemExit("effect credential: authentication endpoint is unavailable") from error
if status_code != 200:
    raise SystemExit(
        f"effect credential: authentication failed with HTTP {status_code}"
    )
if len(response_bytes) > 1_048_576:
    raise SystemExit("effect credential: authentication response is too large")
try:
    response = json.loads(response_bytes)
except (UnicodeDecodeError, ValueError) as error:
    raise SystemExit("effect credential: malformed authentication response") from error

expected = {
    "tenantId": tenant,
    "workloadId": workload,
    "principalId": principal,
    "actorId": actor,
}
for field, value in expected.items():
    if response.get(field) != value:
        raise SystemExit(f"effect credential: authenticated {field} does not match configured identity")
credential_id = response.get("credentialId")
exchange_token = response.get("exchangeToken")
if not isinstance(credential_id, str) or not credential_id:
    raise SystemExit("effect credential: authentication response omitted credentialId")
if not isinstance(exchange_token, str) or not exchange_token:
    raise SystemExit("effect credential: authentication response omitted exchangeToken")

marker = {
    **expected,
    "credentialId": credential_id,
    "checkedAtMicros": str(time.time_ns() // 1000),
}
with open(marker_path, "w", encoding="utf-8") as target:
    json.dump(marker, target, separators=(",", ":"), sort_keys=True)
    target.write("\n")
os.chmod(marker_path, 0o600)
PY
  then
    rm -rf "$temporary"
    trap - EXIT
    return 1
  fi
  if ! mv "$marker_file" "$ready_file"; then
    rm -rf "$temporary"
    trap - EXIT
    return 1
  fi
  rm -rf "$temporary"
  trap - EXIT
}

last=""
while true; do
  diagnostic_file="$(mktemp)"
  if validate 2>"$diagnostic_file"; then
    state="valid"
  else
    state="invalid"
    rm -f "$ready_file"
  fi
  diagnostic="$(sed -n '1p' "$diagnostic_file")"
  rm -f "$diagnostic_file"
  signature="${state}:${diagnostic}"
  if [ "$signature" != "$last" ]; then
    if [ -n "$diagnostic" ]; then
      echo "$diagnostic" >&2
    fi
    echo "effect credential state: ${state}"
    last="$signature"
  fi
  if $once; then
    [ "$state" = "valid" ]
    exit
  fi
  sleep "$interval_seconds"
done
