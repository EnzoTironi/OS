#!/bin/sh
set -eu

require_nonblank() {
  name="$1"
  value="$2"
  case "$value" in
    *[![:space:]]*) ;;
    *)
      echo "eve: ${name} is required" >&2
      exit 1
      ;;
  esac
}

require_nonblank ZOEN_AUTH_BASE_URL "${ZOEN_AUTH_BASE_URL:-}"
require_nonblank ZOEN_ZOEND "${ZOEN_ZOEND:-}"
require_nonblank ZOEN_MODEL "${ZOEN_MODEL:-}"

export PATH="/usr/local/node24/bin:${PATH}"
export ZOEN_BIN="${ZOEN_BIN:-/usr/local/bin/zoen}"
major="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$major" -lt 24 ]; then
  echo "eve: Node >= 24 required, got $(node -v)" >&2
  exit 1
fi
mkdir -p /data/eve
if [ -e /conversation/.eve ] && [ ! -L /conversation/.eve ]; then
  rm -rf /conversation/.eve
fi
ln -sfn /data/eve /conversation/.eve
cd /conversation
exec node ./node_modules/eve/bin/eve.js start --host 127.0.0.1 --port 3000
