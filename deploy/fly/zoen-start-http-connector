#!/bin/sh
set -eu

exec env -i \
  PATH=/usr/local/bin:/usr/bin:/bin \
  RUST_LOG="${RUST_LOG:-info}" \
  ZOEN_CONNECTOR_CALLER_TOKEN="${ZOEN_CONNECTOR_CALLER_TOKEN:?ZOEN_CONNECTOR_CALLER_TOKEN required}" \
  ZOEN_CONNECTOR_CREDENTIALS="${ZOEN_CONNECTOR_CREDENTIALS:?ZOEN_CONNECTOR_CREDENTIALS required}" \
  ZOEN_CONNECTOR_LISTEN_ADDR=127.0.0.1:8081 \
  ZOEN_CONNECTOR_PROVIDER_TIMEOUT_MS="${ZOEN_CONNECTOR_PROVIDER_TIMEOUT_MS:-5000}" \
  ZOEN_CONNECTOR_PROVIDER_URL="${ZOEN_CONNECTOR_PROVIDER_URL:?ZOEN_CONNECTOR_PROVIDER_URL required}" \
  /usr/local/bin/zoen-http-connector
