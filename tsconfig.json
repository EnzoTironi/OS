{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "paths": {
      "@zoen/ontology": [
        "./packages/ontology/src/index.ts"
      ],
      "@zoen/pack": [
        "./packages/pack/src/index.ts"
      ],
      "@zoen/sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@zoen/surface": [
        "./packages/surface/src/index.ts"
      ],
      "@zoen/interaction": [
        "./packages/interaction/src/index.ts"
      ],
      "@zoen/messaging": [
        "./packages/messaging/src/index.ts"
      ],
      "@zoen/onboarding": [
        "./packages/onboarding/src/index.ts"
      ],
      "@zoen/activation-metrics": [
        "./packages/activation-metrics/src/index.ts"
      ]
    },
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": [
      "node"
    ]
  },
  "include": [
    "e2e/**/*.ts",
    "packages/**/*.ts",
    "packs/**/*.ts"
  ]
}
