{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "paths": {
      "@zoen/ontology": [
        "./packages/ontology/src/index.ts"
      ],
      "@zoen/mcp": [
        "./packages/mcp/src/index.ts"
      ]
    },
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": [
      "node"
    ]
  },
  "exclude": [
    "dist",
    "node_modules",
    "e2e/activation-metrics.ts",
    "e2e/activation-metrics/**/*.ts",
    "e2e/activation-onboarding.ts",
    "e2e/activation-onboarding/**/*.ts",
    "e2e/company-bootstrap-shadow.ts",
    "e2e/company-bootstrap-shadow/**/*.ts",
    "e2e/pack-install.ts",
    "e2e/pack-install/**/*.ts",
    "e2e/pack-kitchen.ts",
    "e2e/pack-kitchen/**/*.ts",
    "e2e/pack-registry.ts",
    "e2e/pack-registry/**/*.ts",
    "e2e/personal-family.ts",
    "e2e/personal-family/**/*.ts",
    "e2e/public-surface-web.ts",
    "e2e/public-surface-web/**/*.ts"
  ],
  "include": [
    "e2e/**/*.ts",
    "packages/**/*.ts"
  ]
}
