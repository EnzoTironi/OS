{
  "name": "auth",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/auth.ts src/server.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "auth": "1.7.2",
    "better-auth": "1.7.2",
    "pg": "8.23.0",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "esbuild": "0.25.12",
    "typescript": "5.9.2"
  }
}
