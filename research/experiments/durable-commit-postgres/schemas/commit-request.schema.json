{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os.local/durable-commit-postgres/commit-request.schema.json",
  "title": "SemanticCommitRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "namespace",
    "operation_id",
    "intent_digest",
    "expected_revision",
    "result",
    "records",
    "effect_requests"
  ],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "result": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "kind", "payload"],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object"
          }
        }
      }
    },
    "effect_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "effect_definition_ref",
          "intent_digest",
          "payload"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "effect_definition_ref": {
            "type": "string",
            "minLength": 1
          },
          "intent_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  }
}
