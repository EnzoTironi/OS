{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured Casebook pilot fixture",
  "description": "Experimental normalized fixture of events and claims. Names and enums belong to this pilot and do not define final Casebook syntax. The schema checks local types, enums, required fields, and date-time formats. It does not check whether a locator proves a claim, whether witnesses satisfy scenario preconditions, or whether owner scopes were extracted correctly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "identities",
    "grants",
    "approvals",
    "actions",
    "responsibility_claims",
    "scenario_claims",
    "scenario_instances",
    "occurrences",
    "owners",
    "gaps",
    "effect_attempts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"$ref": "#/$defs/id"},
    "identities": {"type": "array", "items": {"$ref": "#/$defs/identity"}},
    "grants": {"type": "array", "items": {"$ref": "#/$defs/grant"}},
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "responsibility_claims": {"type": "array", "items": {"$ref": "#/$defs/responsibilityClaim"}},
    "scenario_claims": {"type": "array", "items": {"$ref": "#/$defs/scenarioClaim"}},
    "scenario_instances": {"type": "array", "items": {"$ref": "#/$defs/scenarioInstance"}},
    "occurrences": {"type": "array", "items": {"$ref": "#/$defs/occurrence"}},
    "owners": {"type": "array", "items": {"$ref": "#/$defs/owner"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "effect_attempts": {"type": "array", "items": {"$ref": "#/$defs/effectAttempt"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "ref": {"type": "string", "minLength": 1},
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["organization", "person", "agent", "workload"]}
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor_ref", "represented_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "actor_ref": {"$ref": "#/$defs/ref"},
        "represented_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "proposal_ref", "basis_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "proposal_ref": {"$ref": "#/$defs/ref"},
        "basis_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actor_ref",
        "represented_ref",
        "grant_ref",
        "proposal_ref",
        "basis_ref",
        "result"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "actor_ref": {"$ref": "#/$defs/ref"},
        "represented_ref": {"$ref": "#/$defs/ref"},
        "grant_ref": {"$ref": "#/$defs/ref"},
        "proposal_ref": {"$ref": "#/$defs/ref"},
        "basis_ref": {"$ref": "#/$defs/ref"},
        "result": {"enum": ["accepted", "needs_reproposal", "rejected"]},
        "workload_ref": {"$ref": "#/$defs/ref"},
        "approval_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "responsibilityBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["primary_source", "premise", "inference"]},
        "locator": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "primary_source"}},
            "required": ["kind"]
          },
          "then": {"required": ["locator"]}
        }
      ]
    },
    "responsibilityClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "subject_ref": {"$ref": "#/$defs/ref"},
        "basis": {"$ref": "#/$defs/responsibilityBasis"}
      }
    },
    "scenarioClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario_ref", "relationship"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "scenario_ref": {"$ref": "#/$defs/ref"},
        "relationship": {"enum": ["instantiated", "partial", "related"]},
        "instance_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "scenarioInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario_ref", "witness_refs"],
      "description": "witness_refs prove declared existence only. They do not prove that a witness satisfies the scenario.",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "scenario_ref": {"$ref": "#/$defs/ref"},
        "witness_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/ref"}
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "subject_ref": {"$ref": "#/$defs/ref"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "valid_on": {"type": "string", "format": "date"},
        "known_at": {"type": "string", "format": "date-time"}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scopes"],
      "description": "scopes are declared fixture data. The schema does not check extraction from an issue body.",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "scopes": {"$ref": "#/$defs/scopes"}
      }
    },
    "gapOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["known", "unknown"]},
        "owner_ref": {"$ref": "#/$defs/ref"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "known"}},
            "required": ["status"]
          },
          "then": {"required": ["owner_ref"]}
        }
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required_scopes", "owner"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "required_scopes": {"$ref": "#/$defs/scopes"},
        "owner": {"$ref": "#/$defs/gapOwner"}
      }
    },
    "effectAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transport_result", "knowledge_state"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "transport_result": {"enum": ["timeout", "delivered", "rejected"]},
        "knowledge_state": {"enum": ["unknown", "observed", "failed"]}
      }
    }
  }
}
