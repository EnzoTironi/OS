    },
    {
      "definition_id": "computation.identity-plan",
      "result_predicate": null,
      "input_schema": {"type": "object"},
      "result_schema": {"type": "object"},
      "expression": {
        "op": "construct_result",
        "quantity": {
          "op": "if",
          "condition": {"op": "input", "path": "stale"},
          "then": {
            "op": "subtract",
            "left": {"op": "input", "path": "quantity"},
            "right": {"op": "literal", "value": 1}
          },
          "else": {"op": "input", "path": "quantity"}
        },
        "stale": {"op": "input", "path": "stale"}
      }
    },
    {
      "definition_id": "computation.quantity-positive",
      "result_predicate": null,
      "input_schema": {"type": "object"},
      "result_schema": {"type": "boolean"},
      "expression": {
        "op": "compare",
        "cmp": "gt",
        "left": {"op": "input", "path": "quantity"},
        "right": {"op": "literal", "value": 0}
      }
    },
    {
      "definition_id": "computation.release-requires-quality-approval",
      "result_predicate": null,
      "input_schema": {"type": "object"},
      "result_schema": {"type": "boolean"},
      "expression": {
        "op": "any",
        "source": {
          "op": "filter",
          "source": {
            "op": "query_claims",
            "subject": {"op": "input", "path": "subject"},
            "predicate": {"op": "literal", "value": "quality-approval"}
          },
          "where": {
            "op": "compare",
            "cmp": "eq",
            "left": {"op": "input", "path": "item.value"},
            "right": {"op": "literal", "value": true}
          }
        }
      }
    },
    {
      "definition_id": "computation.release-mutations",
