      "input_schema": {"type": "object"},
      "result_schema": {"type": "object"},
      "expression": {
        "op": "construct_result",
        "claim": {
          "op": "construct_claim",
          "claim_id": {"op": "literal", "value": "claim:lot-released"},
          "subject": {"op": "input", "path": "subject"},
          "predicate": {"op": "literal", "value": "lot-status"},
          "value": {"op": "literal", "value": "released"},
          "valid_time": {"op": "input", "path": "now"}
        },
        "effect_request": {
          "op": "construct_effect_request",
          "request_id": {"op": "literal", "value": "effect:release-lot-1"},
          "effect_id": {"op": "literal", "value": "effect.release-lot"},
          "payload": {"op": "literal", "value": {"kind": "release"}}
        }
      }
    },
    {
      "definition_id": "computation.quarantine-mutations",
      "result_predicate": null,
      "input_schema": {"type": "object"},
      "result_schema": {"type": "object"},
      "expression": {
        "op": "construct_result",
        "claim": {
          "op": "construct_claim",
          "claim_id": {"op": "literal", "value": "claim:lot-quarantined"},
          "subject": {"op": "input", "path": "subject"},
          "predicate": {"op": "literal", "value": "lot-status"},
          "value": {"op": "literal", "value": "quarantined"},
          "valid_time": {"op": "input", "path": "now"}
        },
        "effect_request": {
          "op": "construct_effect_request",
          "request_id": {"op": "literal", "value": "effect:move-lot-1"},
          "effect_id": {"op": "literal", "value": "effect.move-lot"},
          "payload": {"op": "literal", "value": {"kind": "move", "destination": "quarantine"}}
        }
      }
    },
    {
      "definition_id": "computation.reconcile-move",
      "result_predicate": null,
      "input_schema": {"type": "object"},
      "result_schema": {"type": "string"},
      "expression": {
        "op": "if",
        "condition": {
          "op": "compare",
          "cmp": "gt",
          "left": {"op": "input", "path": "evidence_count"},
          "right": {"op": "literal", "value": 0}
        },
        "then": {"op": "literal", "value": "confirmed"},
        "else": {"op": "literal", "value": "unknown"}
      }
    },
    {
      "definition_id": "computation.approval-authorized",
      "result_predicate": null,
      "input_schema": {"type": "object"},
      "result_schema": {"type": "boolean"},
      "expression": {
        "op": "all",
        "items": [
          {
            "op": "compare",
            "cmp": "eq",
            "left": {"op": "input", "path": "approver_actor_id"},
            "right": {"op": "literal", "value": "actor:quality-supervisor"}
          },
          {
            "op": "compare",
            "cmp": "eq",
            "left": {"op": "input", "path": "approver_delegation_id"},
            "right": {"op": "literal", "value": "delegation:approve-quality-1"}
          }
        ]
      }
    }
