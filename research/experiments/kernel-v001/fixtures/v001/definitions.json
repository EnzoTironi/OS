  "computations": [
    {
      "definition_id": "computation.available-quantity",
      "result_predicate": "available-quantity",
      "input_schema": {
        "type": "object",
        "properties": {
          "subject": {"type": "string"},
          "predicate": {"type": "string"}
        }
      },
      "result_schema": {"type": "number"},
      "expression": {
        "op": "sum",
        "source": {
          "op": "project",
          "path": "value",
          "source": {
            "op": "query_claims",
            "subject": {"op": "input", "path": "subject"},
            "predicate": {"op": "input", "path": "predicate"}
          }
        }
      }
    },
    {
      "definition_id": "computation.purchase-plan",
      "result_predicate": null,
      "input_schema": {"type": "object"},
      "result_schema": {"type": "object"},
      "expression": {
        "op": "construct_result",
        "quantity": {
          "op": "if",
          "condition": {
            "op": "compare",
            "cmp": "neq",
            "left": {"op": "input", "path": "current_available"},
            "right": {"op": "input", "path": "basis_available"}
          },
          "then": {
            "op": "subtract",
            "left": {"op": "input", "path": "proposed_quantity"},
            "right": {
              "op": "subtract",
              "left": {"op": "input", "path": "current_available"},
              "right": {"op": "input", "path": "basis_available"}
            }
          },
          "else": {"op": "input", "path": "proposed_quantity"}
        },
        "stale": {
          "op": "compare",
          "cmp": "neq",
          "left": {"op": "input", "path": "current_available"},
          "right": {"op": "input", "path": "basis_available"}
        }
      }
    },
    {
      "definition_id": "computation.quantity-positive",
      "result_predicate": null,
      "input_schema": {"type": "object"},
      "result_schema": {"type": "boolean"},
      "expression": {
        "op": "compare",
        "cmp": "gt",
        "left": {"op": "input", "path": "quantity"},
        "right": {"op": "literal", "value": 0}
      }
    },
    {
      "definition_id": "computation.purchase-mutations",
      "result_predicate": null,
      "input_schema": {"type": "object"},
      "result_schema": {"type": "object"},
      "expression": {
        "op": "construct_result",
        "claim": {
          "op": "construct_claim",
          "claim_id": {"op": "literal", "value": "claim:purchase-committed"},
          "subject": {"op": "input", "path": "subject"},
          "predicate": {"op": "literal", "value": "committed-purchase-quantity"},
          "value": {"op": "input", "path": "quantity"},
          "valid_time": {"op": "input", "path": "now"}
        },
        "effect_request": {
          "op": "construct_effect_request",
          "request_id": {"op": "literal", "value": "effect:book-carrier-1"},
          "effect_id": {"op": "literal", "value": "effect.book-carrier"},
          "payload": {"op": "literal", "value": {"kind": "pickup"}}
        }
      }
    },
    {
      "definition_id": "computation.reconcile-carrier",
      "result_predicate": null,
      "input_schema": {"type": "object"},
      "result_schema": {"type": "string"},
      "expression": {
        "op": "if",
        "condition": {
          "op": "compare",
          "cmp": "gt",
          "left": {"op": "input", "path": "evidence_count"},
          "right": {"op": "literal", "value": 0}
        },
        "then": {"op": "literal", "value": "confirmed"},
        "else": {"op": "literal", "value": "unknown"}
      }
    },
    {
      "definition_id": "computation.approval-authorized",
      "result_predicate": null,
      "input_schema": {"type": "object"},
      "result_schema": {"type": "boolean"},
      "expression": {
        "op": "all",
        "items": [
          {
            "op": "compare",
            "cmp": "eq",
            "left": {"op": "input", "path": "approver_actor_id"},
            "right": {"op": "literal", "value": "actor:human-buyer"}
          },
          {
            "op": "compare",
            "cmp": "eq",
            "left": {"op": "input", "path": "approver_delegation_id"},
            "right": {"op": "literal", "value": "delegation:approve-buy-1"}
          }
        ]
      }
    }
  ],
  "rules": [
    {
      "definition_id": "rule.quantity-positive",
      "computation_ref": "computation.quantity-positive",
      "enforcement_locus": "commit",
      "basis_mode": "current_at_commit",
      "error_outcome": "deny",
      "combination_order": 0
    },
    {
      "definition_id": "rule.approval-authorized",
      "computation_ref": "computation.approval-authorized",
      "enforcement_locus": "approval",
      "basis_mode": "proposal",
      "error_outcome": "deny",
      "combination_order": 0
    }
  ],
  "actions": [
    {
      "definition_id": "action.purchase-raw",
      "input_schema": {
        "type": "object",
        "required": ["quantity", "subject", "predicate"],
        "properties": {
          "quantity": {"type": "number"},
          "subject": {"type": "string"},
          "predicate": {"type": "string"}
        }
      },
      "planner_ref": "computation.purchase-plan",
      "rule_refs": ["rule.quantity-positive", "rule.approval-authorized"],
      "state_basis_spec": [
        {
          "id": "available",
          "mode": "current_at_commit",
          "computation_ref": "computation.available-quantity",
          "query": {"subject_input": "subject", "predicate_input": "predicate"}
        }
      ],
      "approval_required": true,
      "stale_behavior": "replan_within_bound",
      "bound_path": "max_quantity",
      "mutation_plan_ref": "computation.purchase-mutations",
      "effect_refs": ["effect.book-carrier"]
    }
  ],
  "effects": [
    {
      "definition_id": "effect.book-carrier",
      "request_schema": {"type": "object"},
      "protocol_safety": {"safe_dedupe": false, "absence_proof": false},
      "reconciliation_ref": "computation.reconcile-carrier"
    }
  ]
}
