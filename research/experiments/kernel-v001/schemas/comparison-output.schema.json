{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os2030.local/schemas/kernel-v001-comparison-output.json",
  "title": "kernel-v001 ComparisonOutput",
  "type": "object",
  "required": [
    "contract_version",
    "scenario_id",
    "engine",
    "input_digest",
    "property_results",
    "structural_metrics"
  ],
  "properties": {
    "contract_version": {"const": "kernel-v001-comparison/1"},
    "scenario_id": {"type": "string"},
    "engine": {"type": "string"},
    "input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_sha": {"type": "string", "minLength": 40},
    "property_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/property_result"}
    },
    "structural_metrics": {"$ref": "#/$defs/structure_report"}
  },
  "additionalProperties": true,
  "$defs": {
    "property_result": {
      "type": "object",
      "required": ["property_id", "passed", "evidence_refs"],
      "properties": {
        "property_id": {"type": "string"},
        "passed": {"type": "boolean"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "measured_metric": {
      "type": "object",
      "required": ["scan_scope", "rule", "findings"],
      "properties": {
        "scan_scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "rule": {"type": "string", "minLength": 1},
        "findings": {"type": "array"}
      },
      "additionalProperties": true
    },
    "structure_report": {
      "type": "object",
      "required": [
        "domain_branches",
        "duplicated_rule_groups",
        "escape_hatches",
        "caller_contract",
        "trusted_commit_path"
      ],
      "properties": {
        "language": {"type": "string"},
        "version": {"type": "string"},
        "source_sha": {"type": "string"},
        "domain_branches": {"$ref": "#/$defs/measured_metric"},
        "duplicated_rule_groups": {"$ref": "#/$defs/measured_metric"},
        "escape_hatches": {"$ref": "#/$defs/measured_metric"},
        "caller_contract": {"$ref": "#/$defs/measured_metric"},
        "trusted_commit_path": {"$ref": "#/$defs/measured_metric"},
        "unsupported": {"type": "object"}
      },
      "additionalProperties": true
    },
    "mutant_matrix": {
      "type": "object",
      "required": ["contract_version", "source_sha", "engines"],
      "properties": {
        "contract_version": {"const": "kernel-v001-mutant-matrix/1"},
        "source_sha": {"type": "string", "minLength": 40},
        "evaluate_run_calls": {"type": "integer"},
        "engines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["engine", "assigned_property", "failed_properties", "allowed_failures", "status"],
            "properties": {
              "engine": {"type": "string"},
              "assigned_property": {"type": ["string", "null"]},
              "failed_properties": {"type": "array", "items": {"type": "string"}},
              "allowed_failures": {"type": "object"},
              "status": {"type": "string"},
              "valid_scenario_run": {"type": "boolean"},
              "exception": {"type": ["string", "null"]},
              "evidence_refs": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
