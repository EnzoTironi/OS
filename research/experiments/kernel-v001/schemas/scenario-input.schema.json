{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os2030.local/schemas/kernel-v001-scenario-input.json",
  "title": "kernel-v001 scenario input",
  "type": "object",
  "required": ["scenario_id", "commands"],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string"},
    "premise": {"type": "string"},
    "temporal_limit": {"type": "object"},
    "clock": {
      "type": "object",
      "properties": {
        "kind": {"type": "string"},
        "start": {"type": "string", "format": "date-time"}
      }
    },
    "knowledge_cuts": {"type": "object"},
    "closing_queries": {"type": "array"},
    "closing_explains": {"type": "array", "items": {"type": "string"}},
    "black_box_expectations": {"type": "object"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"type": "string"},
          "command_id": {"type": "string"},
          "step": {"type": "integer"},
          "clock_time": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "additionalProperties": true
}
