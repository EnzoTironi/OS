{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os.local/research/ops/stop-conditions/scorecard.schema.json",
  "title": "Research readiness scorecard assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "assessed_target",
    "assessed_at",
    "evidence_items",
    "open_questions",
    "experiment_case",
    "stack_bakeoff_case",
    "architectural_promotion_case"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "assessment_id": {
      "type": "string",
      "pattern": "^assessment:[a-z0-9-]+$"
    },
    "assessed_target": { "$ref": "#/$defs/assessedTarget" },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "open_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/openQuestion" }
    },
    "experiment_case": { "$ref": "#/$defs/experimentCase" },
    "stack_bakeoff_case": { "$ref": "#/$defs/stackBakeoffCase" },
    "architectural_promotion_case": { "$ref": "#/$defs/architecturalPromotionCase" }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "anchor"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^E-[0-9]{3}$"
    },
    "nullableEvidenceRef": {
      "anyOf": [
        { "$ref": "#/$defs/evidenceRef" },
        { "type": "null" }
      ]
    },
    "evidenceRefList": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "triState": {
      "type": ["boolean", "null"]
    },
    "assessedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "sha"],
      "properties": {
        "kind": { "const": "research_corpus" },
        "ref": { "type": "string", "minLength": 1 },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "review_state"],
      "properties": {
        "id": { "$ref": "#/$defs/evidenceRef" },
        "kind": {
          "enum": [
            "executable_test",
            "implemented-code",
            "test",
            "observed-execution",
            "official-doc",
            "formal-spec",
            "academic-source",
            "primary-law",
            "real-company-evidence",
            "design-claim",
            "inference"
          ]
        },
        "locator": { "$ref": "#/$defs/locator" },
        "review_state": {
          "enum": [
            "unreviewed",
            "review_clean",
            "challenged",
            "blocked_factual",
            "blocked_deliverable"
          ]
        }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "limit_refs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q-[A-Za-z0-9-]+$"
        },
        "state": {
          "enum": ["blocking", "limited"]
        },
        "limit_refs": { "$ref": "#/$defs/evidenceRefList" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "limited" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "limit_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/evidenceRef" }
              }
            }
          }
        }
      ]
    },
    "experimentCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "question_refs",
        "hypothesis",
        "hypothesis_refs",
        "falsifier",
        "falsifier_refs",
        "discriminating_proof_refs",
        "source_kind",
        "source_kind_refs",
        "limits",
        "limits_refs",
        "normative_promotion",
        "normative_promotion_refs"
      ],
      "properties": {
        "question": { "type": "string" },
        "question_refs": { "$ref": "#/$defs/evidenceRefList" },
        "hypothesis": { "type": "string" },
        "hypothesis_refs": { "$ref": "#/$defs/evidenceRefList" },
        "falsifier": { "type": "string" },
        "falsifier_refs": { "$ref": "#/$defs/evidenceRefList" },
        "discriminating_proof_refs": { "$ref": "#/$defs/evidenceRefList" },
        "source_kind": {
          "enum": [
            "executable_test",
            "implemented-code",
            "test",
            "observed-execution",
            "official-doc",
            "formal-spec",
            "academic-source",
            "primary-law",
            "real-company-evidence",
            "design-claim",
            "inference",
            ""
          ]
        },
        "source_kind_refs": { "$ref": "#/$defs/evidenceRefList" },
        "limits": { "type": "string" },
        "limits_refs": { "$ref": "#/$defs/evidenceRefList" },
        "normative_promotion": { "$ref": "#/$defs/triState" },
        "normative_promotion_refs": { "$ref": "#/$defs/evidenceRefList" }
      }
    },
    "bakeoffCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "execution_refs"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "execution_refs": { "$ref": "#/$defs/evidenceRefList" }
      }
    },
    "stackBakeoffCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_published",
        "suite_ref",
        "candidates",
        "shared_measure_refs",
        "semantic_contract_refs",
        "source_shaped_exceptions"
      ],
      "properties": {
        "suite_published": { "$ref": "#/$defs/triState" },
        "suite_ref": { "$ref": "#/$defs/nullableEvidenceRef" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/bakeoffCandidate" }
        },
        "shared_measure_refs": { "$ref": "#/$defs/evidenceRefList" },
        "semantic_contract_refs": { "$ref": "#/$defs/evidenceRefList" },
        "source_shaped_exceptions": { "$ref": "#/$defs/triState" }
      }
    },
    "architecturalPromotionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_domain_demonstrated",
        "cross_domain_refs",
        "cross_industry_demonstrated",
        "cross_industry_refs",
        "limited_kill_tests_demonstrated",
        "kill_test_refs",
        "high_risk_semantics_demonstrated",
        "high_risk_semantics_refs",
        "competitors_reduced",
        "competitors_reduced_refs",
        "reviewed_sha",
        "current_sha_review_ref",
        "governance_process_ref",
        "adoption_claim"
      ],
      "properties": {
        "cross_domain_demonstrated": { "$ref": "#/$defs/triState" },
        "cross_domain_refs": { "$ref": "#/$defs/evidenceRefList" },
        "cross_industry_demonstrated": { "$ref": "#/$defs/triState" },
        "cross_industry_refs": { "$ref": "#/$defs/evidenceRefList" },
        "limited_kill_tests_demonstrated": { "$ref": "#/$defs/triState" },
        "kill_test_refs": { "$ref": "#/$defs/evidenceRefList" },
        "high_risk_semantics_demonstrated": { "$ref": "#/$defs/triState" },
        "high_risk_semantics_refs": { "$ref": "#/$defs/evidenceRefList" },
        "competitors_reduced": { "$ref": "#/$defs/triState" },
        "competitors_reduced_refs": { "$ref": "#/$defs/evidenceRefList" },
        "reviewed_sha": {
          "type": "string",
          "pattern": "^([0-9a-f]{40})?$"
        },
        "current_sha_review_ref": { "$ref": "#/$defs/nullableEvidenceRef" },
        "governance_process_ref": { "$ref": "#/$defs/nullableEvidenceRef" },
        "adoption_claim": {
          "enum": ["none", "supported"]
        }
      }
    }
  }
}
