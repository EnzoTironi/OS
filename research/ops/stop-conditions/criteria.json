  "checks": [
    {
      "id": "hypothesis-without-falsifier",
      "finding": "hypothesis-without-falsifier",
      "pointer": "/experiment_case/falsifier",
      "message": "A hipótese precisa de um falsificador nomeado.",
      "when": {
        "all": [
          { "nonempty_field": "experiment_case.hypothesis" },
          { "empty_field": "experiment_case.falsifier" }
        ]
      }
    },
    {
      "id": "locator-missing",
      "finding": "locator-missing",
      "pointer": "",
      "message": "Todo locator precisa de path e âncora não vazios.",
      "when": {
        "any_locator_incomplete": true
      }
    },
    {
      "id": "bakeoff-single-candidate",
      "finding": "bakeoff-single-candidate",
      "pointer": "/stack_bakeoff_case/candidates",
      "message": "Um bakeoff com um único candidato não compara stacks.",
      "when": {
        "candidate_count_equals": 1
      }
    },
    {
      "id": "source-shaped-acceptance",
      "finding": "source-shaped-acceptance",
      "pointer": "/stack_bakeoff_case/source_shaped_exceptions",
      "message": "Exceção source-shaped não autoriza bakeoff nem promoção.",
      "when": {
        "field_equals": [
          "stack_bakeoff_case.source_shaped_exceptions",
          true
        ]
      }
    },
    {
      "id": "blocking-question-omitted",
      "finding": "blocking-question-omitted",
      "pointer": "/open_questions",
      "message": "A assessment omitiu uma questão bloqueante exigida pelo catálogo.",
      "when": {
        "required_open_question_missing": true
      }
    },
    {
      "id": "architectural-promotion-accepted",
      "finding": "architectural-promotion-accepted",
      "pointer": "/architectural_promotion_case/adoption_claim",
      "message": "Promoção arquitetural não pode ser tratada como aceita.",
      "when": {
        "any_equals": [
          ["architectural_promotion_case.adoption_claim", "accepted"],
          ["gate_results.architectural_promotion", "allow"],
          ["gate_results.architectural_promotion", "accepted"]
        ]
      }
    }
  ],
  "derivation": {
    "experiment": {
      "allowed_results": ["allow", "block"],
      "rules": [
        {
          "result": "allow",
          "require": {
            "every_criterion_status": "pass",
            "blocking_question_count": 0
          }
        },
        {
          "result": "block",
          "default": true
        }
      ]
    },
    "stack_bakeoff": {
      "allowed_results": ["allow", "block"],
      "rules": [
        {
          "result": "allow",
          "require": {
            "every_criterion_status": "pass",
            "blocking_question_count": 0,
            "min_candidates": 2,
            "source_shaped_exceptions": false
          }
        },
        {
          "result": "block",
          "default": true
        }
      ]
    },
    "architectural_promotion": {
      "allowed_results": ["block", "eligible_for_governance_review"],
      "forbidden_results": ["allow", "accepted"],
      "rules": [
        {
          "result": "eligible_for_governance_review",
          "require": {
            "every_criterion_status": "pass",
            "blocking_question_count": 0,
            "adoption_claim": "none"
          }
        },
        {
          "result": "block",
          "default": true
        }
      ]
    }
  }
}
